{
  "name": "@altera/server",
  "version": "0.5.1",
  "exports": {
    ".": "./main.ts",
    "./sql": "./sql/core-sql.ts"
  },
  "license": "MIT",
  "//publish": "Проби лишаються в репозиторії: у пакеті вони не потрібні, а @std/assert інакше стає залежністю споживача.",
  "publish": {
    "exclude": ["**/*_test.ts"]
  },
  "imports": {
    "@danet/core": "jsr:@danet/core@^2.11.1",
    "@danet/validatte": "jsr:@danet/validatte@^0.7.9",
    "postgres": "npm:postgres@^3.4.5",
    "decimal.js": "npm:decimal.js@^10.6.0",
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/http": "jsr:@std/http@^1.0.18",
    "typebox": "npm:@sinclair/typebox@^0.34.0",
    "pdf-lib": "npm:pdf-lib@^1.17.1",
    "@pdf-lib/fontkit": "npm:@pdf-lib/fontkit@^1.1.1",
    "qrcode-generator": "npm:qrcode-generator@^1.4.4"
  },
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    // deno.window (а не сам deno.ns) додає веб-API — URL, atob, TextDecoder:
    // ними користується рендерер друку.
    "lib": ["deno.window", "deno.unstable", "esnext"]
  }
}
