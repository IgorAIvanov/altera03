{
  "tasks": {
    // DENO_EMIT_CACHE_MODE=disable — тільки для задач, що тягнуть граф Danet.
    // Windows Defender (ML-евристика ObfusScript) хибно спрацьовує на кеші
    // транспіляції: 68% такого файлу — base64 інлайн-sourcemap, і за формою це
    // збігається з упакованим скриптом. Без кешу файл на диск не лягає, а
    // антивірус лишається на повну. Заміряно: різниці у швидкості немає.
    "dev:server": "DENO_EMIT_CACHE_MODE=disable deno run --allow-net --allow-read --allow-write --allow-env --allow-run --env-file --watch ./app/server.ts",
    // --configLoader native: конфіг вантажить Deno, а не бандлер Vite. Інакше
    // Rolldown бандлить vite.config.ts ДО того, як існують аліаси (їх же цей
    // конфіг і задає), не резолвить `@client/vite.ts` і друкує UNRESOLVED_IMPORT
    // на кожній збірці. Працювало й так — імпорт ставав зовнішнім і його
    // резолвив Deno по карті імпортів, вихід побайтово той самий, — але
    // попередження замаскувало б справжній неразрішений імпорт у конфізі.
    // --env-file=.env (з явним значенням, бо далі йде позиційний `npm:vite`):
    // vite.config.ts бере з оточення PORT і VITE_PORT, щоб порти фронта й
    // бекенда задавалися одним файлом і не розходилися між екземплярами.
    "dev:front": "deno run -A --env-file=.env npm:vite --configLoader native",
    "dev": "deno task dev:server & deno task dev:front",
    "build:front": "deno run -A --env-file=.env npm:vite build --configLoader native",
    "preview:front": "deno run -A --env-file=.env npm:vite preview --configLoader native",
    "startdb": "docker compose up -d",
    "stopdb": "docker compose down",
    "sql:registry": "deno run -A ./tools/generate-model-runtime-registry.ts ./app ./app/_generated/model-registry.generated.ts ./app/_generated/agent-routes.generated.ts ./app/_generated/view-manifest.generated.ts --verbose",
    "sql:gen": "deno run -A ./tools/generate-model-sql.ts ./app --verbose",
    // Вбудовує server/sql/**/db/*.sql у core-sql.generated.ts. Запускати після
    // правки SQL ядра; розсинхрон ловить проба в test:unit.
    "core:sql": "deno run -A ./tools/generate-core-sql.ts ./server/sql",
    // Вбудовує тему й локалі фреймворку в TS-модулі. Запускати після правки
    // client/styles/theme.css або client/_locales/*.json.
    "client:assets": "deno run -A ./tools/generate-client-assets.ts ./client --verbose",
    // Складає app/_locales/*.json із _locales/ поряд із кодом (модель, shared,
    // header…). Запускати після правки будь-якого з них; розсинхрон ловить
    // проба в test:unit.
    "locales:build": "deno run -A ./tools/generate-app-locales.ts ./app --verbose",
    // Вбудовує шрифти друку (Roboto з кирилицею) у fonts.generated.ts.
    // Запускати після зміни версії @fontsource/roboto; у встановленому пакеті
    // node_modules поряд немає, тож читати woff з диска рендерер не може.
    "print:fonts": "deno run -A ./tools/generate-print-fonts.ts ./node_modules/@fontsource ./server/modules/print/fonts.generated.ts --verbose",
    // Вбудовує дерево create/template/** у create/template.generated.ts.
    "scaffold:template": "deno run -A ./tools/generate-scaffold-template.ts ./create/template ./create/template.generated.ts --verbose",
    // Вбудовує прикладні скіли (metadata.audience: app) у skills.generated.ts.
    // Запускати після правки skills/src/**; розсинхрон ловить проба в test:unit.
    // Перелік гліфів іде В СКІЛ, бо прикладник пише екран у встановленому
    // застосунку, де фреймворк лежить у vendor/ і взяти список нізвідки.
    // Спершу перелік, потім упаковка — інакше в пакет поїхав би вчорашній.
    "skills:build": "deno run -A ./tools/generate-icons-doc.ts ./client/ui-kit/icons.ts ./skills/src/screen-design-rules/icons.md && deno run -A ./tools/generate-skills.ts ./skills/src ./skills/skills.generated.ts ./CHANGELOG.md --verbose",
    // Генерує застосунок у тимчасовий каталог і перевіряє типи й збірку. На
    // місці шаблон перевірити не можна — він компілюється лише там, де живе.
    "scaffold:verify": "deno run -A ./tools/verify-scaffold.ts ./create/main.ts",
    // Те саме, але проти вихідників цього репозиторію замість опублікованих.
    // Потрібно ДО публікації: у шаблоні стоїть діапазон версій, і поки нової в
    // реєстрі немає, звичайний прогін падає на нерозв'язному пінові, не дійшовши
    // до збірки. А публікація на jsr незворотна — знайти дефект після неї пізно.
    "scaffold:verify:local": "deno run -A ./tools/verify-scaffold.ts ./create/main.ts --local",
    // Перенесення прикладного рішення: `app/` цілком + манифест пакета. Каркас
    // (deno.json, vite.config.ts, scripts/, tsconfig.json) не їде — його дає
    // scaffold. Після завантаження — штатні sql:registry → sql:assemble →
    // sql:publish → build:front, які інструмент навмисно не запускає сам.
    "solution:export": "deno run -A ./tools/export-solution.ts ./app --verbose",
    "solution:import": "deno run -A ./tools/import-solution.ts",
    // Чи чіпали app/ після завантаження: звірка сум із app/.solution.json.
    "solution:status": "deno run -A ./tools/solution-status.ts .",
    // Оновлення одним проходом: розпакування + весь ланцюжок збірки й публікації.
    "solution:update": "deno run -A --env-file ./tools/update-solution.ts",
    // Перевірка типів УСЬОГО дерева, а не `deno check app/main.ts`: екрани
    // підвантажуються динамічно через view-manifest, тож у граф entry вони не
    // входять — і зламаний список чи базовий клас таблиці ця перевірка мовчки
    // пропускала. Знайдено рівно так: зрізаний метод основи не помітили ні
    // check, ні збірка (Vite типи не перевіряє), ні проби.
    "check": "deno check ./app ./client ./server ./tools ./scripts ./mcp",
    "check:deps": "deno run --allow-read ./scripts/check-deps.ts",
    "smoke": "DENO_EMIT_CACHE_MODE=disable deno test --allow-net --allow-read --allow-write --allow-env --allow-run --env-file ./scripts/smoke_test.ts",
    // Юніт-проби бібліотек, яким не потрібні ні БД, ні HTTP: символіки
    // штрих-кодів, читач таблиці звіту. Димові проби межі — окремо, у `smoke`.
    // scripts/ додано ОДНИМ файлом, а не каталогом: поряд лежить smoke_test.ts,
    // якому потрібні база й оточення, і він живе окремою задачею `smoke`.
    "test:unit": "deno test --allow-read --allow-write ./server/ ./client/ ./skills/ ./tools/ ./scripts/version-pins_test.ts ./scripts/app-locales_test.ts ./scripts/translation-markers_test.ts",
    // Проба MCP-обгортки — окремою задачею, бо вона піднімає підроблену базу на
    // порту й запускає обгортку ПІДПРОЦЕСОМ (протокол інакше не перевіриш), а
    // test:unit за домовленістю не ходить ні в БД, ні в мережу.
    "mcp:test": "deno test --allow-net --allow-env --allow-read --allow-run ./mcp/",
    "api": "DENO_EMIT_CACHE_MODE=disable deno run --allow-net --allow-read --allow-write --allow-env --allow-run --env-file ./scripts/api.ts",
    "passwd": "DENO_EMIT_CACHE_MODE=disable deno run --allow-net --allow-read --allow-env --env-file ./tools/set-password.ts",
    // Видача персонального токена: `deno task token <назва> [--write]`. Той самий
    // клас, що passwd — пряма робота з локальною базою під запобіжником оточення.
    // Потрібен тому, що токени видає лише сесія (браузер), а екрана «Мої токени»
    // ще немає: поза браузером узяти токен нізвідки.
    "token": "DENO_EMIT_CACHE_MODE=disable deno run --allow-net --allow-read --allow-env --env-file ./tools/issue-access-token.ts",
    // Через обгортки в scripts/, а не прямим викликом інструмента: SQL ядра
    // приходить у tools аргументом, і назвати його версію може лише застосунок
    // (див. коментар у scripts/sql-assemble.ts).
    "sql:assemble": "deno run -A ./scripts/sql-assemble.ts ./app --verbose",
    "sql:publish": "deno run -A --env-file ./scripts/sql-publish.ts ./app --verbose",
    // Те саме, але для НЕлокальної бази (продуктив, Deno Deploy). Окремим
    // входом, а не прапорцем: запобіжник дев-інструментів стереже те, що
    // smoke/api/passwd ПИШУТЬ тестові дані, і послаблювати його заради
    // публікації схеми не можна. Вимагає --yes і друкує ціль — див. сам файл.
    "sql:deploy": "deno run -A --env-file ./scripts/sql-deploy.ts ./app --verbose",
    // sql:gen тут немає навмисно: згенерований CRUD (app/<model>/db/_generated/
    // *.crud.gen.sql) — закомічений вихідник, а не продукт збірки. Перегенерація
    // робиться свідомо і по одній моделі — `deno task sql:gen catalog/bank`, —
    // коли змінилася схема, і потрапляє в дифф рев'ю. Пакетний прогін без
    // аргументу лишається, але сам себе в збірку не вставляє.
    "model:build": "deno task sql:registry && deno task sql:assemble && deno task sql:publish"
  },

  // Розгортання на Deno Deploy. Конфігурація тут, а не в панелі: заданий у файлі
  // блок перекриває панель цілком, тож розклад видно в дифі й він їде разом з
  // кодом.
  //
  // Схема їде окремим кроком від збірки, і різниця тут не косметична. `build`
  // виконується на кожну збірку, зокрема на ту, що нікуди не поїде; `predeploy`
  // — рівно перед тим, як ревізія почне приймати трафік, і з тими самими
  // змінними, що й застосунок (тобто з `PG*` потрібного контексту: у прев'ю
  // своя база, у продуктиві своя). Тому пакет ЗБИРАЄТЬСЯ в build, а
  // ПУБЛІКУЄТЬСЯ в predeploy — з `--no-assemble`, бо файлова система
  // розгортання не для запису.
  //
  // Ціна свідома: DDL накочується автоматично. Публікація ідемпотентна
  // (структура → міграції → функції → сіди з `on conflict do nothing`), а
  // `--yes` стоїть саме тут, у конфізі, а не в задачі — щоб його не можна було
  // зачепити випадково з машини розробника.
  "deploy": {
    "install": "deno install",
    "build": "deno task sql:assemble && deno task build:front",
    "predeploy": "deno run -A ./scripts/sql-deploy.ts ./app --yes --no-assemble --verbose",
    "runtime": {
      "type": "dynamic",
      // Той самий вхід, що й локально. Порт не задається: Deno.serve під
      // import.meta.main бере PORT або 3000, а слухає за нього платформа.
      "entrypoint": "./app/server.ts"
    }
  },

  "workspace": ["./server", "./client", "./app", "./tools", "./create", "./skills", "./mcp"],
  "imports": {
    "@app/": "./app/",
    "@client/": "./client/",
    "@shared/": "./app/shared/",
    "@danet/core": "jsr:@danet/core@^2.11.1",
    "@danet/validatte": "jsr:@danet/validatte@^0.7.9",
    "@fontsource/roboto": "npm:@fontsource/roboto@^5.2.10",
    "@fontsource/pt-sans": "npm:@fontsource/pt-sans@^5.3.0",
    "pdf-lib": "npm:pdf-lib@^1.17.1",
    "@pdf-lib/fontkit": "npm:@pdf-lib/fontkit@^1.1.1",
    "qrcode-generator": "npm:qrcode-generator@^1.4.4",
    "postgres": "npm:postgres@^3.4.5",

    "decimal.js": "npm:decimal.js@^10.6.0",
    
    "@std/assert": "jsr:@std/assert@^1.0.15",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/path": "jsr:@std/path@^1.1.2",
    "typebox": "npm:@sinclair/typebox@^0.34.0",
    "@sinclair/typebox": "npm:@sinclair/typebox@^0.34.0",
    "@sinclair/typebox/value": "npm:@sinclair/typebox@^0.34.0/value",


    "vite": "npm:vite@^8.2.0",
    "vite-plugin-static-copy": "npm:vite-plugin-static-copy@^4.1.1",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.0",
    "lit": "npm:lit@^3.3.1",
    "@lit-labs/signals": "npm:@lit-labs/signals@^0.1.3",
    "signal-polyfill": "npm:signal-polyfill@^0.2.2",
    "signal-utils": "npm:signal-utils@^0.21.1",
    "daisyui": "npm:daisyui@^5.5.20",
    "tailwindcss": "npm:tailwindcss@^4.3.0"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true
  }
}
