{
  "model": "user",
  "type": "catalog",
  "schema": "app",
  "//table": "Таблиця ядра називається app.users, а не app.user: `user` — зарезервоване слово, і в схемі воно з давніх пір у множині. Потрібно тим, хто на модель ПОСИЛАЄТЬСЯ — без цього x-ref збудував би join у неіснуючу app.user.",
  "table": "users",
  "commands": {
    "ts": {
      "setPassword": {
        "module": "./db/user.commands.ts"
      }
    },
    "access": {
      "setPassword": "edit"
    }
  },
  "views": {
    "list": {
      "module": "./userList.ts",
      "titleKey": "user.titleMany"
    },
    "edit": {
      "module": "./userEdit.ts",
      "titleKey": "user.titleOne"
    },
    "picker": {
      "module": "./userPicker.ts",
      "titleKey": "user.titleMany"
    }
  }
}
