# Усе це збирається в самому образі — з контексту воно лише сповільнює збірку
# й може перекрити щойно зібране (`vendor/` з машини розробника — під іншу ОС).
node_modules/
vendor/
dist/
app/_sqlpackage/*.sql

# .env не потрапляє в образ НІКОЛИ: секрети приходять оточенням контейнера, а
# запечений у шар файл лишився б в образі назавжди — включно з тим, що поїде в
# реєстр.
.env

.git/
.claude/
*.tar.gz
