# Скопіюй у .env і заповни. Той самий файл читає docker-compose.
DB_HOST=localhost
DB_PORT=5432
DB_NAME={{name}}
DB_USERNAME={{name}}
DB_PASSWORD=change-me

# Порт бекенда. Його ж читає vite.config.ts, наводячи проксі /api сюди.
PORT=3000
# Секрет підпису токенів вкладень (HMAC). JWT_SECRET читається як legacy-фолбек.
# У продуктивному оточенні плейсхолдер нижче валить старт сервера — згенеруй власний.
BLOB_TOKEN_SECRET=change-me-in-production
AUTH_SESSION_TTL_HOURS=720
# У продуктиві cookie сесії завжди Secure (дефолт); локально по http лишай порожнім.
AUTH_COOKIE_SECURE=
# Ім'я cookie сесії — своє на кожен застосунок машини. Cookie не розрізняють
# порт: на localhost :3000 і :3001 ділять одну банку, тож зі спільним іменем
# вхід у сусідній застосунок мовчки затирає цю сесію.
AUTH_COOKIE_NAME={{name}}_session

# Логін+пароль разом → на старті створиться адміністратор.
BOOTSTRAP_LOGIN=admin
BOOTSTRAP_PASSWORD=

# Порт dev-сервера Vite (читає vite.config.ts). Зайнятий порт — помилка, а не
# переїзд на наступний, тож для другого застосунку міняй разом із VITE_DEV_URL.
VITE_PORT=5173
# Непорожній → сервер віддає в'ю через Vite (режим розробки).
VITE_DEV_URL=http://localhost:5173
