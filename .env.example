# Підключення до бази — імена libpq, ті самі, що розуміють psql, pg_dump і
# керовані бази. Провайдер, який дає лише рядок, кладеться в DATABASE_URL: він
# читається, коли PGHOST+PGDATABASE не задані. Джерело береться ціле, не по полях.
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require
PGHOST=localhost
PGPORT=5432
PGDATABASE=altera
PGUSER=altera
PGPASSWORD=altera_secret
# TLS до бази: disable | allow | prefer | require | verify-ca | verify-full.
# Порожньо — виводиться з хоста: локальний без TLS, будь-який інший require.
# Тобто для керованої бази цей рядок можна не заповнювати взагалі.
PGSSLMODE=
# Розмір пулу. Своє ім'я, бо поняття пулу в libpq немає. На безсерверному
# розгортанні (ізолятів багато, кожен зі своїм пулом) тримай 1–3.
DB_POOL_SIZE=10
# Ім'я контейнера PostgreSQL із docker-compose. Унікальне на машину: два клони
# репозиторію з однаковим іменем разом не піднімуться, навіть з різним PGPORT.
DB_CONTAINER_NAME=altera-pg-03
# Порт бекенда. Його ж читає vite.config.ts, наводячи проксі /api сюди.
PORT=3000
# Ім'я cookie сесії. УНІКАЛЬНЕ на машину, якщо екземплярів кілька: cookie не
# розрізняють порт, тож :3000 і :3001 на localhost ділять одну банку — вхід у
# другий застосунок мовчки затирає сесію першого. Порожньо → altera_session.
AUTH_COOKIE_NAME=altera_session
# Секрет підпису токенів вкладень (HMAC). JWT_SECRET читається як legacy-фолбек.
# У продуктивному оточенні плейсхолдер нижче валить старт сервера — згенеруй власний.
BLOB_TOKEN_SECRET=change-me-in-production
AUTH_SESSION_TTL_HOURS=720
# У продуктиві cookie сесії завжди Secure (дефолт); локально по http лишай порожнім.
AUTH_COOKIE_SECURE=
BOOTSTRAP_LOGIN=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_FULL_NAME=Bootstrap administrator
DEV_AUTH_BYPASS=0
DEV_AUTH_USER_ID=
# Зовнішня адреса застосунку. Потрібна лише за зворотним проксі: з неї будується
# redirect_uri для провайдерів входу. Порожньо — береться походження запиту.
AUTH_PUBLIC_BASE_URL=
# Провайдер-заглушка для redirect-входу (app/login/dev-redirect-auth.method.ts).
# Пускає без жодної перевірки, тому в продуктивному оточенні валить старт сервера.
DEV_AUTH_REDIRECT=0
DEV_AUTH_REDIRECT_SUBJECT=dev-subject
DEV_AUTH_REDIRECT_EMAIL=
# Порт dev-сервера Vite (читає vite.config.ts). Зайнятий порт тепер помилка, а
# не переїзд на 5174, тож для другого екземпляра змінюй разом із VITE_DEV_URL.
VITE_PORT=5173
VITE_DEV_URL=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ROUTER_MODEL=gpt-4o-mini
