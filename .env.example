DB_HOST=localhost
DB_PORT=5432
DB_NAME=altera
DB_USERNAME=altera
DB_PASSWORD=altera_secret
PORT=3000
JWT_SECRET=change-me-in-production
AUTH_SESSION_TTL_HOURS=720
BOOTSTRAP_LOGIN=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_FULL_NAME=Bootstrap administrator
DEV_AUTH_BYPASS=0
DEV_AUTH_USER_ID=
# Зовнішня адреса застосунку. Потрібна лише за зворотним проксі: з неї будується
# redirect_uri для провайдерів входу. Порожньо — береться походження запиту.
AUTH_PUBLIC_BASE_URL=
# Провайдер-заглушка для redirect-входу (app/login/dev-redirect-auth.method.ts).
# Пускає без жодної перевірки, тому в продуктивному оточенні валить старт сервера.
DEV_AUTH_REDIRECT=0
DEV_AUTH_REDIRECT_SUBJECT=dev-subject
DEV_AUTH_REDIRECT_EMAIL=
VITE_DEV_URL=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ROUTER_MODEL=gpt-4o-mini
